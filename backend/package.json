  "description": "Real-time collaborative task board API (Express + Socket.IO + MongoDB)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "smoke": "node tests/smoke.mjs"
  },
  "keywords": [
